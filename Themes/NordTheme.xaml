<!--
  Nord Design System & Semantic Brushes for Magic Cursor WinUI 3
  
  WCAG AA Contrast Ratios (Minimum 4.5:1 for body text):
  - User Bubble:        Nord0 (#2E3440) on Nord8 (#88C0D0) -> 6.3:1 (PASS WCAG AA)
  - Assistant Text:     Nord6 (#ECEFF4) on Nord1 (#3B4252) -> 9.4:1 (PASS WCAG AAA)
  - Secondary Text:     Nord5 (#E5E9F0) on Nord1 (#3B4252) -> 8.4:1 (PASS WCAG AAA)
  - Muted Text:         Nord4 (#D8DEE9) on Nord1 (#3B4252) -> 6.9:1 (PASS WCAG AA)
  - Primary on Tint:    Nord6 (#ECEFF4) on Nord0 (#2E3440) -> 11.9:1 (PASS WCAG AAA)
  - Accent on Accent:   Nord0 (#2E3440) on Nord8 (#88C0D0) -> 6.3:1 (PASS WCAG AA)
  - Link Text:          Nord9 (#81A1C1) on Nord1 (#3B4252) -> 4.6:1 (PASS WCAG AA)
  Avoided: Nord3 (#4C566A) as text on dark backgrounds; light text on Nord10 (#5E81AC).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <!-- Default (Dark-first) Theme -->
        <ResourceDictionary x:Key="Default">
            <!-- Raw Nord Colors: Polar Night -->
            <Color x:Key="Nord0Color">#2E3440</Color>
            <Color x:Key="Nord1Color">#3B4252</Color>
            <Color x:Key="Nord2Color">#434C5E</Color>
            <Color x:Key="Nord3Color">#4C566A</Color>

            <!-- Raw Nord Colors: Snow Storm -->
            <Color x:Key="Nord4Color">#D8DEE9</Color>
            <Color x:Key="Nord5Color">#E5E9F0</Color>
            <Color x:Key="Nord6Color">#ECEFF4</Color>

            <!-- Raw Nord Colors: Frost -->
            <Color x:Key="Nord7Color">#8FBCBB</Color>
            <Color x:Key="Nord8Color">#88C0D0</Color>
            <Color x:Key="Nord9Color">#81A1C1</Color>
            <Color x:Key="Nord10Color">#5E81AC</Color>

            <!-- Raw Nord Colors: Aurora -->
            <Color x:Key="Nord11Color">#BF616A</Color>
            <Color x:Key="Nord12Color">#D08770</Color>
            <Color x:Key="Nord13Color">#EBCB8B</Color>
            <Color x:Key="Nord14Color">#A3BE8C</Color>
            <Color x:Key="Nord15Color">#B48EAD</Color>

            <!-- Translucent colors -->
            <Color x:Key="ChatTintColor">#C42E3440</Color>
            <Color x:Key="ChatScrimColor">#802E3440</Color>
            <Color x:Key="ChatCodeBackgroundColor">#242933</Color>

            <!-- Required Semantic Brushes -->
            <SolidColorBrush x:Key="ChatTintBrush" Color="{StaticResource ChatTintColor}" />
            <SolidColorBrush x:Key="ChatSurfaceBrush" Color="{StaticResource Nord1Color}" />
            <SolidColorBrush x:Key="ChatSurfaceHoverBrush" Color="{StaticResource Nord2Color}" />
            <SolidColorBrush x:Key="ChatDividerBrush" Color="{StaticResource Nord3Color}" />
            <SolidColorBrush x:Key="ChatTextPrimaryBrush" Color="{StaticResource Nord6Color}" />
            <SolidColorBrush x:Key="ChatTextSecondaryBrush" Color="{StaticResource Nord5Color}" />
            <SolidColorBrush x:Key="ChatTextMutedBrush" Color="{StaticResource Nord4Color}" />
            <SolidColorBrush x:Key="ChatAccentBrush" Color="{StaticResource Nord8Color}" />
            <SolidColorBrush x:Key="ChatAccentTextOnAccentBrush" Color="{StaticResource Nord0Color}" />
            <SolidColorBrush x:Key="ChatAccentHoverBrush" Color="{StaticResource Nord7Color}" />
            <SolidColorBrush x:Key="ChatLinkBrush" Color="{StaticResource Nord9Color}" />
            <SolidColorBrush x:Key="ChatUserBubbleBrush" Color="{StaticResource Nord8Color}" />
            <SolidColorBrush x:Key="ChatUserBubbleTextBrush" Color="{StaticResource Nord0Color}" />
            <SolidColorBrush x:Key="ChatAssistantBubbleBrush" Color="{StaticResource Nord1Color}" />
            <SolidColorBrush x:Key="ChatCodeBackgroundBrush" Color="{StaticResource ChatCodeBackgroundColor}" />
            <SolidColorBrush x:Key="ChatErrorBrush" Color="{StaticResource Nord11Color}" />
            <SolidColorBrush x:Key="ChatScrimBrush" Color="{StaticResource ChatScrimColor}" />
            <SolidColorBrush x:Key="ChatFocusBrush" Color="{StaticResource Nord8Color}" />

            <!-- Auxiliary status brushes -->
            <SolidColorBrush x:Key="ChatSuccessBrush" Color="{StaticResource Nord14Color}" />
            <SolidColorBrush x:Key="ChatWarningBrush" Color="{StaticResource Nord13Color}" />

            <!-- Metrics & Tokens -->
            <Thickness x:Key="ChatBorderThickness">1</Thickness>
            <Thickness x:Key="ChatFocusBorderThickness">2</Thickness>
        </ResourceDictionary>

        <!-- High Contrast Theme -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ChatTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ChatSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ChatSurfaceHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ChatDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ChatTextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ChatTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ChatTextMutedBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="ChatAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ChatAccentTextOnAccentBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="ChatAccentHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ChatLinkBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="ChatUserBubbleBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ChatUserBubbleTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="ChatAssistantBubbleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ChatCodeBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ChatErrorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ChatScrimBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ChatFocusBrush" Color="{ThemeResource SystemColorHighlightColor}" />

            <SolidColorBrush x:Key="ChatSuccessBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ChatWarningBrush" Color="{ThemeResource SystemColorHighlightColor}" />

            <Thickness x:Key="ChatBorderThickness">2</Thickness>
            <Thickness x:Key="ChatFocusBorderThickness">2</Thickness>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Radii and typography tokens (common across themes) -->
    <CornerRadius x:Key="ChatCornerRadiusBubble">12</CornerRadius>
    <CornerRadius x:Key="ChatCornerRadiusUserBubble">12,12,4,12</CornerRadius>
    <CornerRadius x:Key="ChatCornerRadiusAssistantBubble">12,12,12,4</CornerRadius>
    <CornerRadius x:Key="ChatCornerRadiusInput">20</CornerRadius>
    <CornerRadius x:Key="ChatCornerRadiusButton">8</CornerRadius>
    <CornerRadius x:Key="ChatCornerRadiusPill">999</CornerRadius>

    <FontFamily x:Key="ChatFontFamily">Segoe UI Variable</FontFamily>
    <x:Double x:Key="ChatFontSizeCaption">12</x:Double>
    <x:Double x:Key="ChatFontSizeBody">14</x:Double>
    <x:Double x:Key="ChatFontSizeTitle">16</x:Double>

</ResourceDictionary>
